    PUSHBUTTON "Yes to &all", IDD_YESTOALL, 92, 69, 65, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&No", IDNO, 162, 69, 53, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 220, 69, 53, 14, WS_GROUP | WS_TABSTOP
    ICON "", IDD_ICON, 10, 10, 16, 16
    LTEXT "", IDD_MESSAGE, 40, 10, 238, 52, 0
}

SHELL_ABOUT_MSGBOX DIALOG 15, 40, 225, 152
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About %s"
FONT 10, "MS Shell Dlg"
{
 DEFPUSHBUTTON "OK", IDOK, 153, 133, 65, 14, WS_TABSTOP
 PUSHBUTTON "Wine &license", IDC_ABOUT_LICENSE, 153, 113, 65, 14, WS_TABSTOP
 LISTBOX IDC_ABOUT_LISTBOX, 8, 65, 137, 82, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
 ICON "", stc1, 10, 10, 30, 30
 LTEXT "", IDC_ABOUT_STATIC_TEXT1, 42, 10, 180, 10
 LTEXT "", IDC_ABOUT_STATIC_TEXT2, 42, 22, 180, 10
 LTEXT "Running on %s", IDC_ABOUT_STATIC_TEXT3, 42, 34, 180, 10
 LTEXT "Wine was brought to you by:", IDC_ABOUT_WINE_TEXT, 8, 54, 214, 10
}

SHELL_RUN_DLG DIALOG 0, 0, 235, 83
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Run"
FONT 8, "MS Shell Dlg"
{
 ICON "", IDC_RUNDLG_ICON, 7, 11, 18, 20, WS_VISIBLE
 LTEXT "Type the name of a program, folder, document, or Internet resource, and Wine will open it for you.", IDC_RUNDLG_DESCRIPTION, 45, 8, 194, 28
 LTEXT "&Open:", IDC_RUNDLG_LABEL, 7, 39, 35, 10
 CONTROL "", IDC_RUNDLG_EDITPATH, "COMBOBOX", WS_TABSTOP | WS_GROUP | WS_VSCROLL | WS_VISIBLE | CBS_DISABLENOSCROLL | CBS_AUTOHSCROLL | CBS_DROPDOWN, 45, 37, 185, 100
 DEFPUSHBUTTON "OK", IDOK, 72, 63, 50, 14, WS_TABSTOP
 PUSHBUTTON "Cancel", IDCANCEL, 126, 63, 50, 14, WS_TABSTOP
 PUSHBUTTON "&Browse...", IDC_RUNDLG_BROWSE, 180, 63, 50, 14, WS_TABSTOP
}

IDD_FOLDER_PROPERTIES DIALOGEX 0, 0, 240, 155
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON "", IDC_FPROP_ICON, 10, 5, 32, 32, WS_VISIBLE
    EDITTEXT IDC_FPROP_PATH, 70, 10, 160, 14, WS_TABSTOP

    LTEXT "", -1, 5, 30, 230, 1, SS_ETCHEDHORZ
    LTEXT "Type:", IDC_FPROP_TYPE_LABEL, 10, 35, 60, 10
    EDITTEXT IDC_FPROP_TYPE, 70, 35, 160, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    LTEXT "", -1, 5, 50, 230, 1, SS_ETCHEDHORZ
    LTEXT "Location:", IDC_FPROP_LOCATION_LABEL, 10, 55, 60, 10
    EDITTEXT IDC_FPROP_LOCATION, 70, 55, 160, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Size:", IDC_FPROP_SIZE_LABEL, 10, 70, 60, 10
    EDITTEXT IDC_FPROP_SIZE, 70, 70, 160, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    LTEXT "", -1, 5, 85, 230, 1, SS_ETCHEDHORZ
    LTEXT "Created:", IDC_FPROP_CREATED_LABEL, 10, 90, 60, 10
    EDITTEXT IDC_FPROP_CREATED, 70, 90, 160, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    LTEXT "", -1, 5, 105, 230, 1, SS_ETCHEDHORZ
    LTEXT "Attributes:", IDC_FPROP_ATTRIB_LABEL, 10, 110, 60, 10
    AUTOCHECKBOX "&Read-only", IDC_FPROP_READONLY, 70, 110, 70, 10
    AUTOCHECKBOX "H&idden", IDC_FPROP_HIDDEN, 70, 125, 70, 10
    AUTOCHECKBOX "&Archive", IDC_FPROP_ARCHIVE, 70, 140, 70, 10
END

/* Open With, after the ReactOS dialog (LGPL) with Windows XP's texts */
IDD_OPEN_WITH DIALOGEX 0, 0, 264, 256
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUPWINDOW | WS_CAPTION
CAPTION "Open With"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_SHELL_WINDOW, -1, 8, 12, 21, 20
    LTEXT "Choose the program you want to use to open this file:", -1, 44, 12, 211, 10
    LTEXT "File:    ", IDC_OPENWITH_FILE, 44, 25, 188, 20
    GROUPBOX "&Programs", -1, 7, 42, 249, 187
    CONTROL "Programs", IDC_OPENWITH_PROGRAMS, "SysTreeView32", WS_BORDER | WS_TABSTOP | 0x0020 /* TVS_SHOWSELALWAYS */, 16, 57, 230, 130
    AUTOCHECKBOX "&Always use the selected program to open this kind of file", IDC_OPENWITH_ALWAYS, 16, 193, 232, 10
    PUSHBUTTON "&Browse...", IDC_OPENWITH_BROWSE, 188, 207, 60, 14
    DEFPUSHBUTTON "OK", IDOK, 150, 236, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 206, 236, 50, 14
END

IDD_FILE_PROPERTIES DIALOGEX 0, 0, 227, 215
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON "", IDC_FPROP_ICON, 7, 7, 32, 32, WS_VISIBLE
    EDITTEXT IDC_FPROP_PATH, 54, 10, 166, 14, WS_TABSTOP

    LTEXT "", -1, 7, 33, 213, 1, SS_ETCHEDHORZ
    LTEXT "Type of file:", IDC_FPROP_TYPE_LABEL, 7, 41, 60, 10
    EDITTEXT IDC_FPROP_TYPE, 70, 41, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Opens with:", IDC_FPROP_OPENWITH_LABEL, 7, 58, 60, 10
    ICON "", IDC_FPROP_PROG_ICON, 70, 56, 16, 16, WS_VISIBLE
    EDITTEXT IDC_FPROP_PROG_NAME, 88, 58, 75, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    PUSHBUTTON "&Change...", IDC_FPROP_PROG_CHANGE, 165, 55, 55, 14, WS_CHILD | WS_TABSTOP

    LTEXT "", -1, 7, 75, 213, 1, SS_ETCHEDHORZ
    LTEXT "Location:", IDC_FPROP_LOCATION_LABEL, 7, 83, 60, 10
    EDITTEXT IDC_FPROP_LOCATION, 70, 83, 150, 10, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Size:", IDC_FPROP_SIZE_LABEL, 7, 98, 60, 10
    EDITTEXT IDC_FPROP_SIZE, 70, 98, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Size on disk:", IDC_FPROP_SIZEONDISK_LABEL, 7, 113, 60, 10
    EDITTEXT IDC_FPROP_SIZEONDISK, 70, 113, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    LTEXT "", -1, 7, 129, 213, 1, SS_ETCHEDHORZ
    LTEXT "Created:", IDC_FPROP_CREATED_LABEL, 7, 137, 60, 10
    EDITTEXT IDC_FPROP_CREATED, 70, 137, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Modified:", IDC_FPROP_MODIFIED_LABEL, 7, 152, 60, 10
    EDITTEXT IDC_FPROP_MODIFIED, 70, 152, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT "Accessed:", IDC_FPROP_ACCESSED_LABEL, 7, 167, 60, 10
    EDITTEXT IDC_FPROP_ACCESSED, 70, 167, 150, 10, ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP

    LTEXT "", -1, 7, 183, 213, 1, SS_ETCHEDHORZ
    LTEXT "Attributes:", IDC_FPROP_ATTRIB_LABEL, 7, 193, 60, 10
    AUTOCHECKBOX "&Read-only", IDC_FPROP_READONLY, 70, 192, 50, 10
    AUTOCHECKBOX "H&idden", IDC_FPROP_HIDDEN, 122, 192, 45, 10
    AUTOCHECKBOX "&Archive", IDC_FPROP_ARCHIVE, 169, 192, 50, 10
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: shell32.rgs */
1 WINE_REGISTRY shell32.rgs

