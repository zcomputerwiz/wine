#include "shresdef.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

MENU_001 MENU
BEGIN
	MENUITEM "Lar&ge Icons",	FCIDM_SHVIEW_BIGICON
	MENUITEM "S&mall Icons",	FCIDM_SHVIEW_SMALLICON
	MENUITEM "&List",		FCIDM_SHVIEW_LISTVIEW
	MENUITEM "&Details",		FCIDM_SHVIEW_REPORTVIEW
END

/*
 shellview background menu
*/
MENU_002 MENUEX
/* Windows XP's folder background menu.  The ids are offsets from the caller's first id (shlview_cmenu.c):
 * FCIDM_SHVIEW_* - FCIDM_BASE, 0x180+ sort columns, 0x190+ views not implemented yet; New is inserted before
 * Properties by the New menu object. */
BEGIN
	POPUP ""
	BEGIN
	  POPUP "&View",                0x1f0
	  BEGIN
	    MENUITEM "Fil&mstrip",	0x193
	    MENUITEM "Thumb&nails",	0x190
	    MENUITEM "Tile&s",		0x191
	    MENUITEM "Ico&ns",		0x29
	    MENUITEM "&List",		0x2b
	    MENUITEM "&Details",	0x2c
	  END
	  POPUP "Arrange &Icons By",    0x1f1
	  BEGIN
	    MENUITEM "&Name",		0x180
	    MENUITEM "&Size",		0x181
	    MENUITEM "&Type",		0x182
	    MENUITEM "&Modified",	0x183
	    MENUITEM SEPARATOR
	    MENUITEM "Show in &Groups",	0x192, MFT_STRING, MFS_GRAYED
	    MENUITEM "&Auto Arrange",	0x31
	    MENUITEM "A&lign to Grid",	0x32
	  END
	  MENUITEM SEPARATOR
	  MENUITEM "R&efresh",		0x100
	  MENUITEM SEPARATOR
	  MENUITEM "&Paste",		0x1a
	  MENUITEM "Paste &Shortcut",	0x1c
	  MENUITEM SEPARATOR
	  MENUITEM "P&roperties",	0x13
	END
END

/*
 Recycle Bin item menu
*/
MENU_RECYCLEBIN MENU
BEGIN
	POPUP ""
	BEGIN
	  MENUITEM "#msgctxt#recycle bin#&Restore"	IDM_RECYCLEBIN_RESTORE
	  MENUITEM "&Erase"				IDM_RECYCLEBIN_ERASE
	END
END

/*
 shellview item menu
*/
MENU_SHV_FILE MENU
BEGIN
	POPUP ""
	BEGIN
	  MENUITEM "C&ut",		FCIDM_SHVIEW_CUT
	  MENUITEM "&Copy",		FCIDM_SHVIEW_COPY
	  MENUITEM "&Paste",		FCIDM_SHVIEW_INSERT
	  MENUITEM SEPARATOR
	  MENUITEM "Create &Shortcut",	FCIDM_SHVIEW_CREATELINK
	  MENUITEM "&Delete",		FCIDM_SHVIEW_DELETE
	  MENUITEM "&Rename",		FCIDM_SHVIEW_RENAME
	  MENUITEM SEPARATOR
	  MENUITEM "&Properties",	FCIDM_SHVIEW_PROPERTIES
	END
END

MENU_CPANEL MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_CPANEL_EXIT
    END

    POPUP "&View"
    BEGIN
        MENUITEM "Lar&ge Icons", FCIDM_SHVIEW_BIGICON
        MENUITEM "S&mall Icons", FCIDM_SHVIEW_SMALLICON
        MENUITEM "&List", FCIDM_SHVIEW_LISTVIEW
        MENUITEM "&Details", FCIDM_SHVIEW_REPORTVIEW
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&About Control Panel", IDM_CPANEL_ABOUT
    END
END

