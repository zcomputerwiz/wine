#pragma makedep register
#pragma winrt ns_prefix

import "inspectable.idl";
import "asyncinfo.idl";
import "eventtoken.idl";
import "windowscontracts.idl";
import "windows.foundation.idl";
import "windows.system.idl";
import "windows.devices.enumeration.idl";
import "windows.ui.idl";
import "windows.ui.composition.idl";
import "windows.devices.input.idl";
import "windows.ui.core.idl";
import "windows.ui.input.idl";
import "windows.ui.windowmanagement.idl";
import "windows.ui.viewmanagement.idl";
import "windows.ui.text.idl";
import "windows.ui.applicationsettings.idl";

namespace Windows.UI.ApplicationSettings {
    runtimeclass AccountsSettingsPane;
    runtimeclass CredentialCommand;
    runtimeclass SettingsCommand;
    runtimeclass WebAccountCommand;
    runtimeclass WebAccountProviderCommand;
}

namespace Windows.UI.Composition {
    runtimeclass Compositor;
}

namespace WindowsUdk.Foundation.Metadata {
    [
        activatable(Windows.Foundation.UniversalApiContract, 1.0),
        contract(Windows.Foundation.UniversalApiContract, 1.0)
    ]
    runtimeclass ApiInformation
    {
        [default] interface Windows.Foundation.IClosable;
    }
}

namespace Windows.UI.Core {
    runtimeclass CoreWindow;
    runtimeclass SystemNavigationManager;
}

namespace Windows.UI.Text {
    runtimeclass FontWeights;
}

namespace Windows.UI.ViewManagement {
    runtimeclass AccessibilitySettings;
    runtimeclass UISettings;
    runtimeclass UIViewSettings;
    runtimeclass InputPane;
}
