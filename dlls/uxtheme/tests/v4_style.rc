#include "windef.h"
#include "vssym32.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* DWORD header: property, type, class, part, state, resource id, reserved, bytes.
 * Inline payloads are padded to an eight-byte boundary. */
#define PROPERTY_(name, type, cls, part, state, resource, bytes) \
    name##L, type##L, cls##L, part##L, state##L, resource##L, 0L, bytes##L

#define PROPERTY(name, type, cls, part, state, resource, bytes) \
    PROPERTY_(name, type, cls, part, state, resource, bytes)

CMAP CMAP
{
    L"Button\0Window\0Edit\0ScrollBar\0DarkMode::TaskManager\0\0"
}

