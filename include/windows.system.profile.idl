    [contract(Windows.Foundation.UniversalApiContract, 3.0)]
    enum SystemIdentificationSource
    {
        None     = 0,
        Tpm      = 1,
        Uefi     = 2,
        [contract(Windows.Foundation.UniversalApiContract, 5.0)]
        Registry = 3,
    };

