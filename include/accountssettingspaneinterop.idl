import "inspectable.idl";

[
    uuid(d3ee12ad-3865-4362-9746-b75a682df0e6)
]
interface IAccountsSettingsPaneInterop : IInspectable
{
    HRESULT GetForWindow([in] HWND window, [in] REFIID riid, [out, retval, iid_is(riid)] void **pane);
    HRESULT ShowManageAccountsForWindowAsync([in] HWND window, [in] REFIID riid, [out, retval, iid_is(riid)] void **action);
    HRESULT ShowAddAccountForWindowAsync([in] HWND window, [in] REFIID riid, [out, retval, iid_is(riid)] void **action);
}
