#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_CONSENT DIALOGEX 0, 0, 260, 160
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 260, 36
    LTEXT           "Program name:", -1, 14, 46, 56, 10
    LTEXT           "", IDC_UAC_PROGRAM, 74, 46, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "Publisher:", -1, 14, 60, 56, 10
    LTEXT           "", IDC_UAC_PUBLISHER, 74, 60, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "File origin:", -1, 14, 74, 56, 10
    LTEXT           "", IDC_UAC_ORIGIN, 74, 74, 174, 10, SS_LEFT | SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 12, 90, 236, 1
    PUSHBUTTON      "&Details", IDC_UAC_DETAILS_BTN, 14, 98, 46, 14
    EDITTEXT        IDC_UAC_DETAILS_TEXT, 14, 116, 232, 28, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_VISIBLE
    DEFPUSHBUTTON   "&Continue", IDYES, 144, 138, 50, 14
    PUSHBUTTON      "&Cancel", IDNO, 198, 138, 50, 14
END

IDD_CREDENTIALS DIALOGEX 0, 0, 260, 180
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "", IDC_UAC_BANNER, "Static", SS_OWNERDRAW, 0, 0, 260, 36
    LTEXT           "Program name:", -1, 14, 44, 56, 10
    LTEXT           "", IDC_UAC_PROGRAM, 74, 44, 174, 12, SS_LEFT | SS_NOPREFIX
    LTEXT           "Publisher:", -1, 14, 58, 56, 10
    LTEXT           "", IDC_UAC_PUBLISHER, 74, 58, 174, 12, SS_LEFT | SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 12, 72, 236, 1
    LTEXT           "To continue, type an administrator password, and then click Yes.", IDC_UAC_PROMPT, 14, 78, 232, 16
    CONTROL         "", IDC_UAC_USERTILE, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 18, 100, 22, 24
    COMBOBOX        IDC_UAC_ACCOUNT, 48, 100, 196, 80, WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Password:", IDC_UAC_PW_LABEL, 48, 121, 38, 10
    EDITTEXT        IDC_UAC_PASSWORD, 90, 119, 154, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_UAC_ERROR, 14, 144, 232, 12
    DEFPUSHBUTTON   "&Yes", IDYES, 144, 158, 50, 14
    PUSHBUTTON      "&No", IDNO, 198, 158, 50, 14
END
